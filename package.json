{
  "name": "polyglot-helper",
  "productName": "PolyglotHelper",
  "version": "0.1.0",
  "private": true,
  "description": "Assistente de idiomas com notch flutuante e harness local",
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/launch.mjs",
    "dev": "pnpm build && pnpm start",
    "dev:x11": "pnpm build && node scripts/launch.mjs --x11",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:desktop": "pnpm build && playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "setup:asr": "node scripts/setup-asr.mjs",
    "test:asr": "node scripts/test-asr.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.2.3",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
